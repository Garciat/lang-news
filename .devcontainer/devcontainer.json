// Created from the "deno" template of Bare Dev Container Templates.
// Usage, options, security defaults, and tips: https://github.com/bare-devcontainer/templates/tree/main/src/deno
// What is installed in the image, and available tags: https://github.com/bare-devcontainer/images
{
  "name": "Deno",
  "image": "ghcr.io/bare-devcontainer/deno:2-trixie",
  "mounts": [
    // Persist Deno's cache (DENO_DIR) across rebuilds to avoid re-downloading remote modules and npm packages.
    {
      "source": "${devcontainerId}-deno-cache",
      "target": "/home/dev/.cache/deno",
      "type": "volume"
    }
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "denoland.vscode-deno"
      ],
      "settings": {
        "deno.enable": true,
        "deno.path": "/usr/local/bin/deno"
      }
    }
  }
}
